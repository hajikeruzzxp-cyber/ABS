function KUYKUB.AutoPunch()
    Settings.AutoPunch = not Settings.AutoPunch
    if Settings.AutoPunch then
        print("KUYKUB: Auto Punch Enabled")
        while Settings.AutoPunch do
            local target = GetTarget()
            if target and target.Character then
                local targetRoot = target.Character:FindFirstChild("HumanoidRootPart")
                if targetRoot then
                    RootPart.CFrame = CFrame.new(targetRoot.Position + Vector3.new(0, 2, 0))
                    wait(0.1)
                    -- Simulate punch (Remote Event)
                    local remote = ReplicatedStorage:FindFirstChild("RemoteEvent")
                    if remote then
                        remote:FireServer("Punch", target)
                    end
                end
            end
            wait(0.2)
        end
    else
        print("KUYKUB: Auto Punch Disabled")
    end
end

